{
  "name": "@machi-gym/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src prisma/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@machi-gym/contracts": "workspace:*",
    "@nestjs/common": "^10.4.20", "@nestjs/core": "^10.4.20", "@nestjs/platform-express": "^10.4.20",
    "@prisma/client": "6.16.2", "argon2": "^0.44.0", "cookie": "^1.0.2", "dotenv": "^16.6.1", "reflect-metadata": "^0.2.2", "rxjs": "^7.8.2", "zod": "^3.25.76", "zod-to-json-schema": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0", "@types/express": "^4.17.23", "@types/cookie": "^0.6.0", "@types/supertest": "^6.0.3",
    "@eslint/js": "^9.34.0", "eslint": "^9.34.0", "typescript-eslint": "^8.41.0", "prisma": "6.16.2", "supertest": "^7.1.4", "tsx": "^4.20.5", "typescript": "^5.9.2", "vitest": "^3.2.4"
  }
}
