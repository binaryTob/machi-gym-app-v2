generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole {
  ADMIN
  TRAINER
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  DISABLED
}

enum ProfileStatus {
  INCOMPLETE
  READY
  ARCHIVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum ConstraintType {
  LIMITATION
  DECLARED_INJURY
  RECURRING_DISCOMFORT
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
}

enum ExperienceLevel {
  BEGINNER
  NOVICE
  INTERMEDIATE
  ADVANCED
}

enum TrainingGoal {
  WEIGHT_LOSS
  HYPERTROPHY
  STRENGTH
  BODY_RECOMPOSITION
  GENERAL_FITNESS
  SPORT_PERFORMANCE
}

enum Weekday {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MuscleGroup {
  CHEST
  BACK
  SHOULDERS
  BICEPS
  TRICEPS
  FOREARMS
  QUADRICEPS
  HAMSTRINGS
  GLUTES
  CALVES
  CORE
  LOWER_BACK
  FULL_BODY
}

enum Equipment {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  RESISTANCE_BAND
  SMITH_MACHINE
  BENCH
  PULL_UP_BAR
  CARDIO_MACHINE
  OTHER
}

enum MovementPattern {
  HORIZONTAL_PUSH
  VERTICAL_PUSH
  HORIZONTAL_PULL
  VERTICAL_PULL
  SQUAT
  HINGE
  LUNGE
  CARRY
  ISOLATION
  ROTATION
  ANTI_ROTATION
  FLEXION
  EXTENSION
  CONDITIONING
}

enum ExerciseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum ExercisePerformanceMode {
  WEIGHT_REPS
  REPS_ONLY
}

enum LoadEntryConvention {
  TOTAL_EXTERNAL_LOAD
  PER_IMPLEMENT
  MACHINE_STACK
}

enum ExerciseMediaType {
  THUMBNAIL
  GIF
  IMAGE
  VIDEO
  ANIMATION
}

enum MediaLicenseStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum TrainingPlanStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum PlanVersionStatus {
  DRAFT
  ACTIVE
  RETIRED
  VOID
}

enum IntensityMode {
  NONE
  RIR
  RPE
}

enum WorkoutSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  PARTIAL
  CANCELLED
  SKIPPED
}

enum SetCompletionState {
  NOT_STARTED
  COMPLETED
}

enum PartialWorkoutReason {
  LACK_OF_TIME
  FATIGUE
  DISCOMFORT_OR_PAIN
  FEELING_UNWELL
  OTHER
}

enum CancellationReason {
  SCHEDULE_CHANGE
  FEELING_UNWELL
  OTHER
}

enum CancellationActorType {
  STUDENT
  TRAINER
  ADMIN
}

enum SafetyEventType {
  DISCOMFORT_OR_PAIN
  FEELING_UNWELL
}

enum SafetyEventSource {
  EARLY_FINISH
  SESSION_FEEDBACK
}

enum PerceivedState {
  VERY_GOOD
  GOOD
  NORMAL
  DIFFICULT
  VERY_DIFFICULT
}

enum RecoveryState {
  VERY_RECOVERED
  RECOVERED
  NORMAL
  TIRED
  VERY_TIRED
}

enum AiProposalType {
  INITIAL
  ADAPTATION
}

enum AiProposalStatus {
  GENERATING
  READY
  VALIDATION_FAILED
  PROVIDER_FAILED
  APPROVED
  REJECTED
}

enum BodyRegion {
  HEAD_NECK
  LEFT_SHOULDER
  RIGHT_SHOULDER
  LEFT_ARM
  RIGHT_ARM
  LEFT_ELBOW
  RIGHT_ELBOW
  LEFT_WRIST_HAND
  RIGHT_WRIST_HAND
  CHEST
  UPPER_BACK
  LOWER_BACK
  ABDOMEN
  LEFT_HIP
  RIGHT_HIP
  LEFT_THIGH
  RIGHT_THIGH
  LEFT_QUADRICEPS
  RIGHT_QUADRICEPS
  LEFT_HAMSTRING
  RIGHT_HAMSTRING
  LEFT_CALF
  RIGHT_CALF
  LEFT_KNEE
  RIGHT_KNEE
  LEFT_LOWER_LEG
  RIGHT_LOWER_LEG
  LEFT_ANKLE_FOOT
  RIGHT_ANKLE_FOOT
  OTHER
}

model Organization {
  id          String       @id @default(cuid())
  name        String
  timezone    String       @default("UTC")
  createdAt   DateTime     @default(now())
  memberships Membership[]
  students    StudentProfile[]
  exercises   Exercise[]
  trainingPlans TrainingPlan[]
  planAssignments StudentPlanAssignment[]
  workoutSessions WorkoutSession[]
  sessionFeedbacks SessionFeedback[]
  discomfortReports DiscomfortReport[]
  monthlyProgressSnapshots MonthlyProgressSnapshot[]
  aiProposals AiTrainingProposal[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  displayName  String
  disabledAt   DateTime?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  sessions     AuthSession[]
  resetTokens  PasswordResetToken[]
  mfaFactor    MfaFactor?
}

model Membership {
  id             String            @id @default(cuid())
  organizationId String
  userId         String
  role           MembershipRole
  status         MembershipStatus  @default(ACTIVE)
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user           User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  sessions       AuthSession[]
  trainerProfile TrainerProfile?
  studentProfile StudentProfile?
  reviewed       StudentProfile[]  @relation("ProfileReviewer")
  invitations    StudentInvitation[]
  notes          TrainerNote[]
  weights        BodyWeightMeasurement[]
  audit          AuditEvent[]
  mediaVerified ExerciseMedia[] @relation("MediaVerifier")
  createdPlans TrainingPlan[] @relation("PlanCreator")
  createdPlanVersions TrainingPlanVersion[] @relation("PlanVersionCreator")
  publishedPlanVersions TrainingPlanVersion[] @relation("PlanVersionPublisher")
  retiredPlanVersions TrainingPlanVersion[] @relation("PlanVersionRetirer")
  voidedPlanVersions TrainingPlanVersion[] @relation("PlanVersionVoider")
  assignedPlans StudentPlanAssignment[] @relation("PlanAssigner")
  scheduledSessions WorkoutSession[] @relation("SessionScheduler")
  cancelledSessions WorkoutSession[] @relation("SessionCanceller")
  skippedSessions WorkoutSession[] @relation("SessionSkipper")
  aiRequests AiTrainingProposal[] @relation("AiRequester")
  aiReviews AiTrainingProposal[] @relation("AiReviewer")

  @@unique([organizationId, userId])
  @@unique([id, organizationId])
  @@unique([id, organizationId, userId])
  @@index([organizationId, role, status])
}

model AuthSession {
  id                String     @id @default(cuid())
  userId            String
  membershipId      String
  organizationId    String
  tokenHash         String     @unique
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  createdAt         DateTime   @default(now())
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  membership        Membership @relation(fields: [membershipId, organizationId, userId], references: [id, organizationId, userId], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MfaFactor {
  id               String    @id @default(cuid())
  userId           String    @unique
  secretCiphertext String
  verifiedAt       DateTime?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes    MfaRecoveryCode[]
}

model MfaRecoveryCode {
  id       String    @id @default(cuid())
  factorId String
  hash     String    @unique
  usedAt   DateTime?
  factor   MfaFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)
}

model TrainerProfile {
  id             String     @id @default(cuid())
  organizationId String
  membershipId   String     @unique
  membership     Membership @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignments    TrainerStudentAssignment[]

  @@unique([id, organizationId])
  @@unique([membershipId, organizationId])
}

model StudentProfile {
  id                            String          @id @default(cuid())
  organizationId                String
  membershipId                  String?         @unique
  displayName                   String
  contactEmail                  String
  birthDate                     DateTime?       @db.Date
  heightCm                      Decimal?        @db.Decimal(5, 2)
  trainingFrequencyPerWeek      Int?
  availableDays                 Weekday[]
  approximateSessionMinutes     Int?
  activityLevel                 ActivityLevel?
  experienceLevel               ExperienceLevel?
  primaryGoal                   TrainingGoal?
  timezone                      String?
  status                        ProfileStatus   @default(INCOMPLETE)
  planningRevision              Int             @default(1)
  reviewedPlanningRevision      Int?
  profileReviewedAt             DateTime?
  profileReviewedByMembershipId String?
  version                       Int             @default(1)
  createdAt                     DateTime        @default(now())
  organization                  Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership                    Membership?     @relation(fields: [membershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reviewer                      Membership?     @relation("ProfileReviewer", fields: [profileReviewedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invitations                   StudentInvitation[]
  assignments                   TrainerStudentAssignment[]
  activities                    ExternalActivity[]
  constraints                   StudentConstraint[]
  weights                       BodyWeightMeasurement[]
  notes                         TrainerNote[]
  planAssignments               StudentPlanAssignment[]
  workoutSessions                WorkoutSession[]
  sessionFeedbacks               SessionFeedback[]
  discomfortReports              DiscomfortReport[]
  monthlyProgressSnapshots        MonthlyProgressSnapshot[]
  aiProposals                    AiTrainingProposal[]

  @@unique([id, organizationId])
  @@unique([membershipId, organizationId])
  @@index([organizationId, displayName])
}

model TrainerStudentAssignment {
  id             String         @id @default(cuid())
  organizationId String
  trainerId      String
  studentId      String
  active         Boolean        @default(true)
  trainer        TrainerProfile @relation(fields: [trainerId, organizationId], references: [id, organizationId], onDelete: Restrict)
  student        StudentProfile @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([trainerId, studentId])
  @@index([organizationId, trainerId, active, studentId])
}

model StudentInvitation {
  id                    String           @id @default(cuid())
  organizationId        String
  studentId             String
  invitedByMembershipId String
  email                 String
  tokenHash             String           @unique
  status                InvitationStatus @default(PENDING)
  expiresAt             DateTime
  acceptedAt            DateTime?
  createdAt             DateTime         @default(now())
  student               StudentProfile   @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  invitedBy             Membership       @relation(fields: [invitedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, email, status])
}

model StudentConstraint {
  id          String         @id @default(cuid())
  studentId   String
  type        ConstraintType
  description String
  active      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
}

model ExternalActivity {
  id              String         @id @default(cuid())
  studentId       String
  name            String
  weeklyFrequency Int?
  createdAt       DateTime       @default(now())
  student         StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
}

model BodyWeightMeasurement {
  id                     String         @id @default(cuid())
  organizationId         String
  studentId              String
  recordedByMembershipId String
  weightKg               Decimal        @db.Decimal(6, 2)
  measuredAt             DateTime
  createdAt              DateTime       @default(now())
  student                StudentProfile @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recordedBy             Membership     @relation(fields: [recordedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, studentId, measuredAt])
}

model MonthlyProgressSnapshot {
  id              String         @id @default(cuid())
  organizationId  String
  studentId       String
  year            Int
  month           Int
  analyticsVersion Int
  revision        Int
  periodStart     DateTime       @db.Date
  periodEnd       DateTime       @db.Date
  timezone        String
  metrics         Json
  generatedAt     DateTime       @default(now())
  supersededAt    DateTime?
  correctionReason String?
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "monthly_progress_org_fk")
  student         StudentProfile @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "monthly_progress_student_fk")

  @@unique([organizationId, studentId, year, month, analyticsVersion, revision], map: "monthly_progress_revision_key")
  @@index([organizationId, studentId, year, month], map: "monthly_progress_month_idx")
}

model TrainerNote {
  id                 String         @id @default(cuid())
  organizationId     String
  studentId          String
  authorMembershipId String
  content            String
  createdAt          DateTime       @default(now())
  student            StudentProfile @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  author             Membership     @relation(fields: [authorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
}

model AuditEvent {
  id                String      @id @default(cuid())
  organizationId    String
  actorMembershipId String?
  action            String
  resourceType      String
  resourceId        String
  occurredAt        DateTime    @default(now())
  actor             Membership? @relation(fields: [actorMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
}

model Exercise {
  id                    String                  @id @default(cuid())
  organizationId        String
  name                  String
  slug                  String
  aliases               String[]
  searchText            String
  description           String
  primaryMuscleGroup    MuscleGroup
  secondaryMuscleGroups MuscleGroup[]
  equipment             Equipment[]
  movementPattern       MovementPattern
  difficulty            ExerciseDifficulty
  performanceMode       ExercisePerformanceMode
  loadEntryConvention   LoadEntryConvention?
  loadMultiplier        Decimal                 @default(1) @db.Decimal(5, 2)
  instructions          String
  commonMistakes        String
  cautionNotes          String?
  active                Boolean                 @default(true)
  aiEligible            Boolean                 @default(false)
  version               Int                     @default(1)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  organization          Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  media                 ExerciseMedia[]
  programmedExercises  ProgrammedExercise[]
  sessionExercises      SessionExercise[]
  discomfortReports     DiscomfortReport[]

  @@unique([organizationId, slug])
  @@unique([id, organizationId])
  @@index([organizationId, active, name])
  @@index([organizationId, primaryMuscleGroup, active])
  @@index([organizationId, movementPattern, active])
}

model ExerciseMedia {
  id                     String             @id @default(cuid())
  organizationId         String
  exerciseId             String
  type                   ExerciseMediaType
  url                    String
  source                 String
  sourceUrl              String?
  licenseName            String
  attributionText        String
  licenseStatus          MediaLicenseStatus @default(PENDING)
  verifiedByMembershipId String?
  verifiedAt             DateTime?
  active                 Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  exercise               Exercise           @relation(fields: [exerciseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  verifiedBy             Membership?        @relation("MediaVerifier", fields: [verifiedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([exerciseId, type, url])
  @@index([exerciseId, active, licenseStatus])
}

model TrainingPlan {
  id                    String             @id @default(cuid())
  organizationId        String
  createdByMembershipId String
  name                  String
  description           String?
  goal                  TrainingGoal
  status                TrainingPlanStatus @default(DRAFT)
  version               Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  archivedAt            DateTime?
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy             Membership         @relation("PlanCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  versions              TrainingPlanVersion[]
  assignments           StudentPlanAssignment[]

  @@unique([id, organizationId])
  @@index([organizationId, status, createdAt])
}

model TrainingPlanVersion {
  id                      String            @id @default(cuid())
  organizationId          String
  trainingPlanId          String
  versionNumber           Int
  status                  PlanVersionStatus @default(DRAFT)
  revision                Int               @default(1)
  title                   String
  description             String?
  goal                    TrainingGoal
  createdByMembershipId   String
  publishedByMembershipId String?
  publishedAt             DateTime?
  retiredByMembershipId   String?
  retiredAt               DateTime?
  voidedByMembershipId    String?
  voidedAt                DateTime?
  voidReason              String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  trainingPlan            TrainingPlan      @relation(fields: [trainingPlanId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy               Membership        @relation("PlanVersionCreator", fields: [createdByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  publishedBy             Membership?       @relation("PlanVersionPublisher", fields: [publishedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  retiredBy               Membership?       @relation("PlanVersionRetirer", fields: [retiredByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  voidedBy                Membership?       @relation("PlanVersionVoider", fields: [voidedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workouts                WorkoutTemplate[]
  assignments             StudentPlanAssignment[]
  workoutSessions         WorkoutSession[]
  aiSourceProposals       AiTrainingProposal[] @relation("AiSourceVersion")
  aiApprovedProposals     AiTrainingProposal[] @relation("AiApprovedVersion")

  @@unique([trainingPlanId, versionNumber])
  @@unique([id, organizationId])
  @@unique([id, organizationId, trainingPlanId])
  @@index([trainingPlanId, status])
}

model AiTrainingProposal {
  id                     String @id @default(cuid())
  organizationId         String
  studentId              String
  requestedByMembershipId String
  requestKey             String
  type                   AiProposalType
  status                 AiProposalStatus @default(GENERATING)
  sourceVersionId        String?
  approvedVersionId      String? @unique(map: "ai_proposal_approved_version")
  provider               String
  model                  String
  promptVersion          String
  contextVersion         String
  contextHash            String
  contextSummary         Json
  originalProposal       Json?
  editedProposal         Json?
  validationResult       Json
  revision               Int @default(1)
  attempts               Int @default(1)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt
  reviewedAt             DateTime?
  reviewedByMembershipId String?
  rejectionReason        String?
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "ai_proposal_organization_fk")
  student                StudentProfile @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "ai_proposal_student_fk")
  requester              Membership @relation("AiRequester", fields: [requestedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "ai_proposal_requester_fk")
  reviewer               Membership? @relation("AiReviewer", fields: [reviewedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "ai_proposal_reviewer_fk")
  sourceVersion          TrainingPlanVersion? @relation("AiSourceVersion", fields: [sourceVersionId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "ai_proposal_source_fk")
  approvedVersion        TrainingPlanVersion? @relation("AiApprovedVersion", fields: [approvedVersionId, organizationId], references: [id, organizationId], onDelete: Restrict, map: "ai_proposal_approved_fk")

  @@unique([organizationId, requestKey], map: "ai_proposal_request_key")
  @@index([organizationId, studentId, createdAt], map: "ai_proposal_roster")
}

model WorkoutTemplate {
  id                     String   @id @default(cuid())
  organizationId         String
  trainingPlanVersionId  String
  name                   String
  description            String?
  order                  Int
  expectedDurationMinutes Int?
  dayLabel               String?
  trainerNotes           String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  trainingPlanVersion    TrainingPlanVersion @relation(fields: [trainingPlanVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  exercises              ProgrammedExercise[]
  workoutSessions        WorkoutSession[]

  @@unique([trainingPlanVersionId, order])
  @@unique([id, organizationId])
}

model ProgrammedExercise {
  id                           String       @id @default(cuid())
  organizationId               String
  workoutTemplateId            String
  exerciseId                   String
  order                        Int
  targetSets                   Int
  targetRepsMin                Int
  targetRepsMax                Int
  intensityMode                IntensityMode @default(NONE)
  targetRir                    Int?
  targetRpe                    Decimal?      @db.Decimal(3, 1)
  restSeconds                  Int
  suggestedLoadKg              Decimal?      @db.Decimal(7, 2)
  trainerNotes                 String?
  exerciseVersionSnapshot      Int?
  exerciseNameSnapshot         String?
  primaryMuscleSnapshot        MuscleGroup?
  performanceModeSnapshot      ExercisePerformanceMode?
  loadEntryConventionSnapshot  LoadEntryConvention?
  loadMultiplierSnapshot       Decimal?      @db.Decimal(5, 2)
  instructionsSnapshot         String?
  commonMistakesSnapshot       String?
  cautionNotesSnapshot         String?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime      @updatedAt
  workoutTemplate              WorkoutTemplate @relation(fields: [workoutTemplateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  exercise                     Exercise @relation(fields: [exerciseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sessionExercises             SessionExercise[]

  @@unique([workoutTemplateId, order])
  @@unique([workoutTemplateId, exerciseId])
  @@unique([id, organizationId])
  @@index([exerciseId])
}

model StudentPlanAssignment {
  id                     String         @id @default(cuid())
  organizationId         String
  studentId              String
  trainingPlanId         String
  trainingPlanVersionId  String
  assignedByMembershipId String
  startDate              DateTime       @db.Date
  endDate                DateTime?      @db.Date
  active                 Boolean        @default(true)
  assignedAt             DateTime       @default(now())
  endedAt                DateTime?
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student                StudentProfile @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  plan                   TrainingPlan   @relation(fields: [trainingPlanId, organizationId], references: [id, organizationId], onDelete: Restrict)
  planVersion            TrainingPlanVersion @relation(fields: [trainingPlanVersionId, organizationId, trainingPlanId], references: [id, organizationId, trainingPlanId], onDelete: Restrict)
  assignedBy             Membership     @relation("PlanAssigner", fields: [assignedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workoutSessions        WorkoutSession[]

  @@unique([id, organizationId])
  @@unique([id, organizationId, trainingPlanVersionId])
  @@index([organizationId, studentId, assignedAt])
  @@index([trainingPlanVersionId, active])
}

model WorkoutSession {
  id                     String               @id @default(cuid())
  organizationId         String
  studentId              String
  studentPlanAssignmentId String
  trainingPlanVersionId  String
  workoutTemplateId      String
  scheduledByMembershipId String
  scheduleRequestKey     String
  scheduledDate          DateTime             @db.Date
  timezone               String
  status                 WorkoutSessionStatus @default(NOT_STARTED)
  snapshotSealed         Boolean              @default(false)
  startedAt              DateTime?
  finishedAt             DateTime?
  partialReason          PartialWorkoutReason?
  partialReasonDetail    String?
  cancellationReason     CancellationReason?
  cancellationActorType  CancellationActorType?
  cancelledByMembershipId String?
  cancelledAt            DateTime?
  skippedByMembershipId  String?
  skippedAt              DateTime?
  version                Int                  @default(1)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student                StudentProfile       @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  assignment             StudentPlanAssignment @relation(fields: [studentPlanAssignmentId, organizationId, trainingPlanVersionId], references: [id, organizationId, trainingPlanVersionId], onDelete: Restrict)
  planVersion            TrainingPlanVersion  @relation(fields: [trainingPlanVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workoutTemplate        WorkoutTemplate      @relation(fields: [workoutTemplateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  scheduledBy            Membership           @relation("SessionScheduler", fields: [scheduledByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  cancelledBy            Membership?          @relation("SessionCanceller", fields: [cancelledByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  skippedBy              Membership?          @relation("SessionSkipper", fields: [skippedByMembershipId, organizationId], references: [id, organizationId], onDelete: Restrict)
  exercises              SessionExercise[]
  safetyEvents           SessionSafetyEvent[]
  feedback               SessionFeedback?
  discomfortReports      DiscomfortReport[]

  @@unique([id, organizationId])
  @@unique([id, organizationId, studentId])
  @@unique([organizationId, scheduleRequestKey])
  @@index([organizationId, studentId, scheduledDate, status])
  @@index([organizationId, studentId, finishedAt, id])
}

model SessionExercise {
  id                          String                  @id @default(cuid())
  organizationId              String
  workoutSessionId            String
  programmedExerciseId        String
  exerciseId                  String
  order                       Int
  exerciseNameSnapshot        String
  primaryMuscleSnapshot       MuscleGroup
  performanceModeSnapshot     ExercisePerformanceMode
  loadEntryConventionSnapshot LoadEntryConvention?
  loadMultiplierSnapshot      Decimal                 @db.Decimal(5, 2)
  instructionsSnapshot        String
  commonMistakesSnapshot      String
  cautionNotesSnapshot        String?
  targetSets                  Int
  targetRepsMin               Int
  targetRepsMax               Int
  intensityMode               IntensityMode
  targetRir                   Int?
  targetRpe                   Decimal?                @db.Decimal(3, 1)
  restSeconds                 Int
  trainerNotes                String?
  suggestedLoadKg             Decimal?                @db.Decimal(7, 2)
  createdAt                   DateTime                @default(now())
  workoutSession              WorkoutSession          @relation(fields: [workoutSessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  programmedExercise          ProgrammedExercise      @relation(fields: [programmedExerciseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  exercise                    Exercise                @relation(fields: [exerciseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sets                        SetPerformance[]

  @@unique([workoutSessionId, order])
  @@unique([workoutSessionId, programmedExerciseId])
  @@unique([id, organizationId])
  @@index([workoutSessionId, exerciseId])
}

model SetPerformance {
  id                  String             @id @default(cuid())
  organizationId      String
  sessionExerciseId   String
  setNumber           Int
  completionState     SetCompletionState @default(NOT_STARTED)
  actualLoadKg        Decimal?           @db.Decimal(7, 2)
  actualRepetitions   Int?
  rir                 Int?
  rpe                 Decimal?           @db.Decimal(3, 1)
  completedAt         DateTime?
  version             Int                @default(1)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  sessionExercise     SessionExercise    @relation(fields: [sessionExerciseId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([sessionExerciseId, setNumber])
  @@unique([id, organizationId])
}

model SessionSafetyEvent {
  id               String            @id @default(cuid())
  organizationId   String
  workoutSessionId String
  sessionFeedbackId String?
  type             SafetyEventType
  source           SafetyEventSource @default(EARLY_FINISH)
  bodyRegion       BodyRegion?
  intensity        Int?
  notes            String?
  createdAt        DateTime          @default(now())
  workoutSession   WorkoutSession    @relation(fields: [workoutSessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sessionFeedback  SessionFeedback?   @relation(fields: [sessionFeedbackId, organizationId, workoutSessionId], references: [id, organizationId, workoutSessionId], onDelete: Restrict)
  discomfortReport DiscomfortReport?

  @@unique([id, workoutSessionId, organizationId])
  @@index([organizationId, type, createdAt])
  @@index([workoutSessionId])
}

model SessionFeedback {
  id               String         @id @default(cuid())
  organizationId   String
  studentId        String
  workoutSessionId String         @unique
  sessionRpe       Int
  perceivedState   PerceivedState
  recoveryState    RecoveryState
  discomfortPresent Boolean
  generalNotes     String?
  requestHash      String
  submittedAt      DateTime       @default(now())
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student          StudentProfile @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workoutSession   WorkoutSession @relation(fields: [workoutSessionId, organizationId, studentId], references: [id, organizationId, studentId], onDelete: Restrict)
  discomfortReports DiscomfortReport[]
  safetyEvents     SessionSafetyEvent[]

  @@unique([id, organizationId, workoutSessionId])
  @@unique([id, organizationId, studentId, workoutSessionId])
  @@unique([workoutSessionId, organizationId, studentId])
  @@index([organizationId, studentId, submittedAt])
}

model DiscomfortReport {
  id                String         @id @default(cuid())
  organizationId    String
  studentId         String
  workoutSessionId  String
  sessionFeedbackId String
  safetyEventId     String         @unique
  bodyRegion        BodyRegion
  otherLocation     String?
  intensity         Int
  exerciseId        String?
  notes             String?
  createdAt         DateTime       @default(now())
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  student           StudentProfile @relation(fields: [studentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  workoutSession    WorkoutSession @relation(fields: [workoutSessionId, organizationId, studentId], references: [id, organizationId, studentId], onDelete: Restrict)
  sessionFeedback   SessionFeedback @relation(fields: [sessionFeedbackId, organizationId, studentId, workoutSessionId], references: [id, organizationId, studentId, workoutSessionId], onDelete: Restrict)
  safetyEvent       SessionSafetyEvent @relation(fields: [safetyEventId, workoutSessionId, organizationId], references: [id, workoutSessionId, organizationId], onDelete: Restrict)
  exercise          Exercise?      @relation(fields: [exerciseId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([sessionFeedbackId, bodyRegion])
  @@unique([safetyEventId, workoutSessionId, organizationId])
  @@index([organizationId, studentId, bodyRegion, createdAt])
  @@index([organizationId, bodyRegion, createdAt])
  @@index([exerciseId, createdAt])
}
